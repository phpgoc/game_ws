FROM ghcr.io/rust-cross/rust-musl-cross:aarch64-musl AS builder

WORKDIR /workspace
COPY . .

RUN ./ci/prepare-public-build.sh \
    && cargo build \
        --release \
        --target aarch64-unknown-linux-musl \
        --manifest-path Cargo.toml \
        -p ws_server \
        -p p2p \
        --no-default-features \
    && mkdir -p /artifact \
    && for service in ws_server p2p; do \
        install -m 0755 \
            "target/aarch64-unknown-linux-musl/release/${service}" \
            "/artifact/${service}"; \
    done

FROM scratch AS artifact
COPY --from=builder /artifact/ /

FROM ghcr.io/rust-cross/rust-musl-cross:aarch64-musl AS builder

WORKDIR /workspace
COPY . .

RUN ./ci/prepare-public-build.sh \
    && cargo build \
        --release \
        --target aarch64-unknown-linux-musl \
        --manifest-path Cargo.toml \
        -p landlord \
        -p shenyang_mahjong \
        -p holdem \
        -p tractor \
        -p dominoes \
        -p upgrade \
        -p p2p \
        --no-default-features \
    && mkdir -p /artifact \
    && for game in landlord shenyang_mahjong holdem tractor dominoes upgrade p2p; do \
        install -m 0755 \
            "target/aarch64-unknown-linux-musl/release/${game}" \
            "/artifact/${game}"; \
    done

FROM scratch AS artifact
COPY --from=builder /artifact/ /
